{
  "name": "py-transcribe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:serve": "vite build && vite preview --host 127.0.0.1 --port 4173",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "@wllama/wllama": "^3.5.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  }
}
